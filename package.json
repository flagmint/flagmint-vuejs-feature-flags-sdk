{
  "name": "flagmint-vuejs-feature-flags",
  "version": "1.3.1",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "keywords": [
    "vue",
    "feature flags",
    "sdk",
    "flagmint",
    "feature-flags",
    "vue2",
    "vue3"
  ],
  "description": "A Vue.js SDK for managing feature flags in Flagmint applications, supporting both Vue 2 and Vue 3.",
  "author": "Flagmint Team",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "jest --runInBand --detectOpenHandles",
    "build": "rollup -c"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.24",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.5.16",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.0-beta.3",
    "jest-fetch-mock": "^3.0.3",
    "rollup": "^4.41.1",
    "rollup-plugin-dts": "^6.2.1",
    "rollup-plugin-typescript2": "^0.36.0",
    "rollup-plugin-vue": "^6.0.0",
    "ts-jest": "^29.3.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "vue-template-compiler": "^2.7.16"
  },
  "dependencies": {
    "flagmint-js-sdk": "^1.2.24",
    "vue": "^2.7.0 || ^3.2.0",
    "vue-demi": "^0.14.10"
  },
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./vue2": {
      "import": "./dist/vue2.mjs",
      "types": "./dist/vue2.d.ts"
    },
    "./vue3": {
      "import": "./dist/vue3.mjs",
      "types": "./dist/vue3.d.ts"
    },
    "./vue3/FlagmintFeatureGate": {
      "import": "./dist/vue3-flagmint-feature-gate.mjs"
    }
  }
}
